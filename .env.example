# Optional. Defaults to the same-origin `/api/home` proxy, which avoids the
# upstream API's CORS allowlist (it only permits localhost origins). Set this to
# an absolute URL only if the upstream ever allowlists your deployed origin.
# VITE_HOME_API_BASE_URL=https://subscriptionapp-wgf8.onrender.com/api/v1/home

# Prototype-only Google Maps demo key. This app uses the Maps JavaScript
# Place class for search and Geocoding API v4 for reverse geocoding.
# Keep real keys in .env.local and use a restricted production key/backend proxy when deploying.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_demo_key
