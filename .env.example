# Use the same-origin proxy locally and on Vercel so browser CORS does not
# depend on changes to the employer-owned API.
VITE_HOME_API_BASE_URL=/api/home

# Prototype-only Google Maps demo key. This app uses the Maps JavaScript
# Place class for search and Geocoding API v4 for reverse geocoding.
# Keep real keys in .env.local and use a restricted production key/backend proxy when deploying.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_demo_key
